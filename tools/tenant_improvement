from datetime import date
from fastmcp import FastMCP
from db import query, build_where

tenant_improvement = FastMCP("tenant_improvement")

TENANT_IMPROVMENT_COLS = ("ti_id", "lease_id", "property_id",
                          "space_id", "approved_amount", "committed_amount",
                          "actual_amount", "start_date", "completion_date")

@tenant_improvement.tool
def get_tenant_improvement(ti_id: int) -> dict | None:
    """Get a single tenant improvement by ti_id. Returns null if not found."""
    rows = query(f"SELECT {TENANT_IMPROVMENT_COLS} FROM smartreit.tenant_improvement WHERE ti_id = %s",
                 (ti_id,))
    return rows[0] if rows else None

@tenant_improvement.tool
def find_tenant_improvements(
    ti_id: int | None = None,
    lease_id: int | None = None,
    property_id: int | None = None,
    space_id: int | None = None,
    approved_amount: float | None = None,
    committed_amount: float | None = None,
    actual_amount: float | None = None,
    start_date: date | None = None,
    completion_date: date | None = None,
    limit: int = 50,
) -> list[dict]:
    """Search tenant improvements. All filters are optional and combined with AND.
    Omit a filter to ignore it; call with no filters to list tenant improvements."""
    where, params = build_where(
        {"ti_id": ti_id, "lease_id": lease_id, "property_id": property_id,
         "space_id": space_id, "approved_amount": approved_amount,
         "committed_amount": committed_amount, "actual_amount": actual_amount,
         "start_date": start_date, "completion_date": completion_date},
    )
    sql = (f"SELECT {TENANT_IMPROVMENT_COLS} FROM smartreit.tenant_improvement{where} "
           "ORDER BY ti_id LIMIT %s")
    return query(sql, params + [min(limit, 200)])

@tenant_improvement.tool
def tenant_improvement_exists(ti_id: int) -> bool:
    """Check if a tenant improvement exists by ti_id."""
    rows = query(f"SELECT 1 FROM smartreit.tenant_improvement WHERE ti_id = %s", (ti_id,))
    return bool(rows)

@tenant_improvement.tool
def count_pending_tenant_improvements() -> int:
    """Count the total number of ongoing tenant improvements."""
    rows = query("SELECT COUNT(*) AS count FROM smartreit.tenant_improvement " \
    "WHERE completion_date IS NULL")
    return rows[0]["count"] if rows else 0



